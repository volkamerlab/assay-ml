
universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = run_training.sh
arguments = $(script) $(seed) $(dataset) $(method) $(fold)
output = logs/train_dti.$(ClusterId).$(ProcId).out
error = logs/train_dti.$(ClusterId).$(ProcId).err
log = logs/train_dti.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue fold, script, seed, dataset, method from (
    0, scripts/train.py, 0, :andrum, ic50
    0, scripts/train.py, 0, omnivore, hodge
    0, scripts/train.py, 0, omnivore, set
    0, scripts/train.py, 0, omnivore, setall
    0, scripts/train.py, 0, omnivore, pair
    0, scripts/train.py, 0, omnivore, pairall
    1, scripts/train.py, 0, omnivore, ic50
    1, scripts/train.py, 0, omnivore, hodge
    1, scripts/train.py, 0, omnivore, set
    1, scripts/train.py, 0, omnivore, setall
    1, scripts/train.py, 0, omnivore, pair
    1, scripts/train.py, 0, omnivore, pairall
    2, scripts/train.py, 0, omnivore, ic50
    2, scripts/train.py, 0, omnivore, hodge
    2, scripts/train.py, 0, omnivore, set
    2, scripts/train.py, 0, omnivore, setall
    2, scripts/train.py, 0, omnivore, pair
    2, scripts/train.py, 0, omnivore, pairall
    3, scripts/train.py, 0, omnivore, ic50
    3, scripts/train.py, 0, omnivore, hodge
    3, scripts/train.py, 0, omnivore, set
    3, scripts/train.py, 0, omnivore, setall
    3, scripts/train.py, 0, omnivore, pair
    3, scripts/train.py, 0, omnivore, pairall
    4, scripts/train.py, 0, omnivore, ic50
    4, scripts/train.py, 0, omnivore, hodge
    4, scripts/train.py, 0, omnivore, set
    4, scripts/train.py, 0, omnivore, setall
    4, scripts/train.py, 0, omnivore, pair
    4, scripts/train.py, 0, omnivore, pairall
)
