universe = docker
docker_image = astral/uv:debian
executable = run_training.sh
arguments = $(script) $(seed) $(dataset) $(method) $(fold) $(mol_feat)
output = logs/train_dti.$(ClusterId).$(ProcId).out
error = logs/train_dti.$(ClusterId).$(ProcId).err
log = logs/train_dti.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue fold, script, seed, dataset, method, mol_feat from (
    0, scripts/train.py, 1, kinodata, sets, morgan
    0, scripts/train.py, 1, kinodata, sets, rdkit
    0, scripts/train.py, 1, kinodata, sets, topological_torsion
    0, scripts/train.py, 1, kinodata, sets, atom_pair
    0, scripts/train.py, 1, omnivore, sets, morgan
    0, scripts/train.py, 1, omnivore, sets, rdkit
    0, scripts/train.py, 1, omnivore, sets, topological_torsion
    0, scripts/train.py, 1, omnivore, sets, atom_pair
    0, scripts/train.py, 1, landrum, sets, morgan
    0, scripts/train.py, 1, landrum, sets, rdkit
    0, scripts/train.py, 1, landrum, sets, topological_torsion
    0, scripts/train.py, 1, landrum, sets, atom_pair
    0, scripts/train.py, 1, kinodata, allsets, morgan
    0, scripts/train.py, 1, kinodata, allsets, rdkit
    0, scripts/train.py, 1, kinodata, allsets, topological_torsion
    0, scripts/train.py, 1, kinodata, allsets, atom_pair
    0, scripts/train.py, 1, omnivore, allsets, morgan
    0, scripts/train.py, 1, omnivore, allsets, rdkit
    0, scripts/train.py, 1, omnivore, allsets, topological_torsion
    0, scripts/train.py, 1, omnivore, allsets, atom_pair
    0, scripts/train.py, 1, landrum, allsets, morgan
    0, scripts/train.py, 1, landrum, allsets, rdkit
    0, scripts/train.py, 1, landrum, allsets, topological_torsion
    0, scripts/train.py, 1, landrum, allsets, atom_pair
    0, scripts/train.py, 1, kinodata, ic50, morgan
    0, scripts/train.py, 1, kinodata, ic50, rdkit
    0, scripts/train.py, 1, kinodata, ic50, topological_torsion
    0, scripts/train.py, 1, kinodata, ic50, atom_pair
    0, scripts/train.py, 1, omnivore, ic50, morgan
    0, scripts/train.py, 1, omnivore, ic50, rdkit
    0, scripts/train.py, 1, omnivore, ic50, topological_torsion
    0, scripts/train.py, 1, omnivore, ic50, atom_pair
    0, scripts/train.py, 1, landrum, ic50, morgan
    0, scripts/train.py, 1, landrum, ic50, rdkit
    0, scripts/train.py, 1, landrum, ic50, topological_torsion
    0, scripts/train.py, 1, landrum, ic50, atom_pair
)
