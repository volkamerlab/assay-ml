universe = docker
docker_image = astral/uv:debian
executable = run_pfn_training.sh
arguments = $(script) $(seed) $(dataset) $(method) $(fold) $(mol_feat) $(unmasked_weight) $(physchem)
output = logs/pfn_train.$(ClusterId).$(ProcId).out
error = logs/pfn_train.$(ClusterId).$(ProcId).err
log = logs/pfn_train.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 24
request_memory = 400GB
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue fold, script, seed, dataset, method, mol_feat, unmasked_weight, physchem from (
    0, scripts/train.py, 0, chembl, pfn, morgan, 0.0, 0.5
)
