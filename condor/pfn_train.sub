universe = docker
docker_image = astral/uv:debian
executable = run_training.sh
arguments = $(script) $(seed) $(dataset) $(method) $(fold) $(mol_feat) $(unmasked_weight)
output = logs/train_dti.$(ClusterId).$(ProcId).out
error = logs/train_dti.$(ClusterId).$(ProcId).err
log = logs/train_dti.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 8
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue fold, script, seed, dataset, method, mol_feat, unmasked_weight from (
    0, scripts/train.py, 0, chembl, pfn, morgan, 0.0
    0, scripts/train.py, 0, chembl, pfn, morgan, 0.5
    0, scripts/train.py, 0, chembl, pfn, morgan, 1.0
)
