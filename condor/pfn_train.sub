universe = docker
docker_image = astral/uv:debian
executable = run_pfn_training.sh
arguments = $(script) $(fold) $(n_bins) $(mol_feat) $(unmasked_weight) $(physcem)
output = logs/pfn_train.$(ClusterId).$(ProcId).out
error = logs/pfn_train.$(ClusterId).$(ProcId).err
log = logs/pfn_train.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 8
request_memory = 300GB
requirements = (GPUs_Capability >= 7.0) && (GPUs_GlobalMemoryMb >= 16000)
+WantGPUHomeMounted = true
queue fold, script, n_bins, mol_feat, unmasked_weight, physcem from (
    0, scripts/pfn_train.py, 10,    morgan, 0.0, 0.25
    0, scripts/pfn_train.py, 100,   morgan, 0.0, 0.25
    0, scripts/pfn_train.py, 1000,  morgan, 0.0, 0.25
    0, scripts/pfn_train.py, 10000,  morgan, 0.0, 0.25
)
