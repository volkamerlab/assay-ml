universe = docker
docker_image = astral/uv:debian
executable = run_pfn_training.sh
arguments = $(script) $(fold) $(mol_feat) $(unmasked_weight) $(physcem) $(n_bins)
output = logs/pfn_train.$(ClusterId).$(ProcId).out
error = logs/pfn_train.$(ClusterId).$(ProcId).err
log = logs/pfn_train.$(ClusterId).$(ProcId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 300GB
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue script, fold, mol_feat, unmasked_weight, physchem, n_bins from (
    scripts/pfn_train.py, 0, morgan, 0.0, 0.0, 100
)
